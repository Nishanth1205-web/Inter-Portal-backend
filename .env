# Copy this file to .env and fill in your values

# Database
DATABASE_URL="postgresql://inter_portal_db_user:SDZnJVgSuAuhcmIrBknbjpXxx6X7jwOF@dpg-dan36i142hec73d1vom0-a.oregon-postgres.render.com/inter_portal_db?sslmode=require"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_REFRESH_SECRET="your-refresh-token-secret-change-this-in-production"
