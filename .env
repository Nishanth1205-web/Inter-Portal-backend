# Server
PORT=5000
NODE_ENV="development"
CORS_ORIGIN="http://localhost:5173"

# File Upload
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=52428800

# AI Provider (mock | openai | gemini)
AI_PROVIDER="mock"
# OPENAI_API_KEY=""
# GEMINI_API_KEY=""

# Logging
LOG_LEVEL="info"
